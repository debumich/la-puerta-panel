rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSiteAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.systemRole == 'site_admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /avatars/{userId} {
      allow read: if true;
      allow create, update: if signedIn()
        && (request.auth.uid == userId || isSiteAdmin())
        && validImage();
      allow delete: if signedIn() && (request.auth.uid == userId || isSiteAdmin());
    }

    match /factionLogos/{factionId} {
      allow read: if true;
      allow create, update: if isSiteAdmin() && validImage();
      allow delete: if isSiteAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
